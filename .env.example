# Put your Telegram BotFather token in .env or your host's secret environment variables.
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Optional: URL of a self-hosted LibreTranslate instance, without a trailing slash.
# If omitted, the bot uses local Argos Translate models and downloads them when needed.
# LIBRETRANSLATE_URL=http://localhost:5000

# Faster-Whisper model size: tiny (low memory) or base/small (better, heavier).
WHISPER_MODEL=tiny
MAX_DOWNLOAD_MB=20
TESSERACT_LANGUAGES=eng+mal+ara+hin+urd+tam+spa+fra+deu+chi_sim+jpn
